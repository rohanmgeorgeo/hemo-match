# =============================================================================
# Hemo Match - Environment Variables Configuration
# Challenge: SC-12 (District Blood Donor Matching)
# =============================================================================
#
# INSTRUCTIONS:
# Copy this file to `.env.local` for local development.
# Replace placeholder values with your project credentials.
# NEVER commit real secret keys to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# SUPABASE - Public / Browser-Safe Variables
# ---------------------------------------------------------------------------

# Supabase Project URL (safe to expose to browser when RLS is enabled)
# Example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
# Safe to expose when Row Level Security (RLS) is properly configured.
# Provides read access only to publicly-readable data, and write access
# only through RLS-guarded paths.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# ---------------------------------------------------------------------------
# SUPABASE - Server-Only / Private Variables
# CRITICAL: These MUST NOT be exposed to browser/client components.
# Use these in Next.js Route Handlers, Server Actions, or server lib only.
# ---------------------------------------------------------------------------

# Supabase Service Role Key — bypasses RLS for trusted server operations.
# Required for: admin migrations, background jobs, server-to-server queries.
# NEVER prefix with NEXT_PUBLIC_. NEVER import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# ---------------------------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------------------------

# Application base URL (used for absolute URL generation, e.g., emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (automatically set by Next.js in most contexts)
# NODE_ENV=development
